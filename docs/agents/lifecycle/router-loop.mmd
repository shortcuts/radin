flowchart TD
  p0[Phase 0<br/>state preflight] --> p1[Phase 1<br/>resolve scope]
  p0 -. session line .-> note1[read session file]
  p0 -. stuck line .-> note2[recover stuck]
  p0 -. waiting line .-> note3[settle questions]
  p0 -. rank line .-> note4[rank unset ids]
  p0 -. leftovers line .-> note5[state reconcile: land every task branch]
  note5 -- conflict, exit 3 --> leafM
  p0 -. candidate line .-> note6[state stash-triage: factfind per candidate, stash-claim]
  p1 --> p2[Phase 2<br/>print order, user picks tasks]
  p2 --> p3[Phase 3<br/>persist BACKLOG_STEPS.json]
  p3 --> p35[Phase 3.5<br/>settle open decisions, one grilling]
  p35 --> mode{worktree}
  mode -- no, serial --> next{{task-next}}
  mode -- yes, waves --> wave{{state wave}}
  wave -- exit 1 --> p45
  wave --> wplan[plan unplanned tasks<br/>one message]
  wplan --> leafP
  wplan --> part[state wave-partition --wave N]
  part --> veto[factfind per group:<br/>graph veto, never merge groups]
  veto --> group[state group-set --wave N<br/>one group, up to the cap]
  group --> leafE
  next -- exit 1, nothing left or teardown requested --> p45[Phase 4.5<br/>session gate: lint, format, review]
  p45 -- findings filed, once --> next
  next -- exit 0 --> kind{kind}
  kind -- planning --> leafP[[Planning leaf]]
  kind -- execution --> leafE[[Execution leaf]]
  leafE -- STATUS line --> report[task-report]
  leafE -. idle, no STATUS .-> nudge[claude: ListAgents, one nudge]
  hb([claude: per-task cron heartbeat, 20 min]) -. fires .-> nudge
  nudge --> report
  leafP -- STATUS line --> report
  leafE -. agents: leaf returns, no STATUS .-> report
  leafP -. agents: leaf returns, no STATUS .-> report
  report -- commit on a side branch --> blocked[blocked until the merge lands]
  report -- commit leaves its plan paths --> route
  report --> route{next}
  route -- continue --> next
  route -- wave landed, refill --> wave
  route -- debug --> debug[[Debug leaf, once]]
  debug --> next
  route -- clarify --> user[/Ask the user<br/>FACT or DECISION/]
  user --> next
  p45 --> p47[Phase 4.7<br/>merge task branches]
  p47 --> mergeCli[radin state reconcile squash]
  mergeCli -- all landed, tasks done, Finish entries filed --> p5[Phase 5<br/>state report]
  mergeCli -- conflict, exit 3 --> leafM[[Merge leaf]]
  p47 -- no branches --> p5
  leafM -- SUCCESS --> mergeCli
  p5 -. waiting entries left .-> ask5[ask: settle now?<br/>yes: same grilling as Phase 0]
  p5 --> p6
  leafM --> p6[Phase 6<br/>point to /radin-review]
