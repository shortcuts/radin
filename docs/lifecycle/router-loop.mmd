flowchart TD
  p0[Phase 0<br/>state preflight] --> p1[Phase 1<br/>resolve scope]
  p0 -. session line .-> note1[read session file]
  p0 -. stuck line .-> note2[recover stuck]
  p0 -. waiting line .-> note3[settle questions]
  p0 -. rank line .-> note4[rank unset ids]
  p0 -. leftovers line .-> note5[state reconcile: merge done leftovers]
  note5 -- conflict, exit 3 --> leafM
  p1 --> p2[Phase 2<br/>print order, user picks tasks]
  p2 --> p3[Phase 3<br/>persist BACKLOG_STEPS.json]
  p3 --> p35[Phase 3.5<br/>settle open decisions, one grilling]
  p35 --> next{{task-next}}
  next -- exit 1, nothing left --> p45[Phase 4.5<br/>session gate: full suite]
  next -- exit 0 --> kind{kind}
  kind -- planning --> leafP[[Planning leaf]]
  kind -- execution --> leafE[[Execution leaf]]
  leafE -- STATUS line --> report[task-report]
  leafP -- STATUS line --> report
  report --> route{next}
  route -- continue --> next
  route -- debug --> debug[[Debug leaf, once]]
  debug --> next
  route -- clarify --> user[/Ask the user<br/>FACT or DECISION/]
  user --> next
  p45 --> p5[Phase 5<br/>state report]
  p5 --> p55[Phase 5.5<br/>merge task branches]
  p55 --> mergeCli[radin state merge squash]
  mergeCli -- all merged --> p6
  mergeCli -- conflict, exit 3 --> leafM[[Merge leaf]]
  p55 -- no branches --> p6
  leafM --> p6[Phase 6<br/>review offer]
