flowchart TD
  p0[Phase 0<br/>find backlog] --> p05[Phase 0.5<br/>worktree and branch answers]
  p05 --> p1[Phase 1<br/>reconcile, recover stuck, rank]
  p1 --> p2[Phase 2<br/>print order, user picks tasks]
  p2 --> p3[Phase 3<br/>persist BACKLOG_STEPS.json]
  p3 --> next{{task-next}}
  next -- exit 1, nothing left --> p45[Phase 4.5<br/>session gate: full suite]
  next -- exit 0 --> kind{kind}
  kind -- planning --> leafP[[Planning leaf]]
  kind -- execution --> leafE[[Execution leaf]]
  leafP -- STATUS: PLANNED --> next
  leafE -- STATUS line --> report[task-report]
  leafP -- other STATUS --> report
  report --> route{next}
  route -- continue --> next
  route -- debug --> debug[[Debug leaf, once]]
  debug --> next
  route -- clarify --> user[/Ask the user<br/>FACT, DECISION or STUCK/]
  user --> next
  p45 --> p5[Phase 5<br/>state report]
  p5 --> p6[Phase 6<br/>review offer]
