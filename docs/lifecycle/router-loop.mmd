flowchart TD
  p0[Phase 0<br/>find backlog] --> p05[Phase 0.5<br/>worktree and branch answers]
  p05 --> p1[Phase 1<br/>reconcile, recover stuck, settle waiting questions, rank]
  p1 --> p2[Phase 2<br/>print order, user picks tasks]
  p2 --> p3[Phase 3<br/>persist BACKLOG_STEPS.json]
  p3 --> p35[Phase 3.5<br/>settle open decisions, one grilling]
  p35 --> next{{task-next}}
  next -- exit 1, nothing left --> p45[Phase 4.5<br/>session gate: full suite]
  next -- exit 0 --> kind{kind}
  kind -- planning --> leafP[[Planning leaf]]
  kind -- execution --> leafE[[Execution leaf]]
  leafE -- STATUS line --> report[task-report]
  leafP -- STATUS line --> report
  report --> route{next}
  route -- continue --> next
  route -- debug --> debug[[Debug leaf, once]]
  debug --> next
  route -- clarify --> user[/Ask the user<br/>FACT or DECISION/]
  user --> next
  p45 --> p5[Phase 5<br/>state report]
  p5 --> p55[Phase 5.5<br/>offer merge of task branches]
  p55 -- merge all --> leafM[[Merge leaf]]
  p55 -- skip or no branches --> p6
  leafM --> p6[Phase 6<br/>review offer]
