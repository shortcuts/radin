#!/usr/bin/env bash
# radin CLI dispatcher: one command on PATH instead of long
# `bash ~/.claude/.radin/lib/radin-<name>.sh` invocations in every skill.
# Installed to ~/.claude/.radin/bin/radin and symlinked into ~/.local/bin
# by install.sh. Must stay bash-3.2-compatible (macOS /bin/bash).
set -euo pipefail

LIB="$HOME/.claude/.radin/lib"

usage() {
	printf 'usage: radin <backlog|state|scope|prompt|hooks|repair|update|doctor|uninstall> [args]\n'
	printf 'With no subcommand on a terminal, radin opens the TUI; "radin help" prints this text.\n'
	printf 'Each subcommand prints its own usage when run with no arguments.\n'
}

cmd="${1:-}"
# Bare `radin` is the human entry point: on a terminal it execs the TUI.
# Piped or redirected it falls through to the usage text below, so a skill or
# pipe can never get trapped in a full-screen app.
if [ -z "$cmd" ] && [ -t 1 ]; then
	# The only compiled artifact; install.sh builds it from lib/radin-tui.c.
	[ -x "$HOME/.claude/.radin/bin/radin-tui" ] || {
		printf 'radin: TUI not built (no C compiler at install time). Use "radin backlog show".\n' >&2
		exit 1
	}
	RADIN_LIB="$LIB" exec "$HOME/.claude/.radin/bin/radin-tui"
fi

case "$cmd" in
backlog | state | scope | prompt | update | doctor | uninstall)
	shift
	exec bash "$LIB/radin-$cmd.sh" "$@"
	;;
hooks)
	shift
	# Merge-only wiring, one repo or the user scope: codebase-memory-mcp's
	# skill/agents/hooks/MCP entry today, so the caller names no companion.
	exec bash "$LIB/radin-cbm-hooks.sh" "$@"
	;;
repair)
	# Fixed verb, no passthrough: repair always restores hooks and the MCP
	# entry another tool's own config write dropped -- codebase-memory-mcp's
	# today, so the caller names no companion or JSON file.
	exec bash "$LIB/radin-cbm-config.sh" repair
	;;
help)
	usage
	;;
*)
	usage >&2
	exit 1
	;;
esac
