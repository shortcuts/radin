#!/usr/bin/env bash
# radin CLI dispatcher: one command on PATH instead of long
# `bash ~/.claude/.radin/lib/radin-<name>.sh` invocations in every skill.
# Installed to ~/.claude/.radin/bin/radin and symlinked into ~/.local/bin
# by install.sh. Must stay bash-3.2-compatible (macOS /bin/bash).
set -euo pipefail

LIB="$HOME/.claude/.radin/lib"

usage() {
	printf 'usage: radin <backlog|tui|state|scope|cbm-hooks|cbm-config|update|doctor|uninstall> [args]\n'
	printf 'With no subcommand on a terminal, radin opens the TUI; "radin help" prints this text.\n'
	printf 'Each subcommand prints its own usage when run with no arguments.\n'
}

cmd="${1:-}"
# Bare `radin` is the human entry point: on a terminal it is `radin tui`.
# Piped or redirected it falls through to the usage text below, so a skill or
# pipe can never get trapped in a full-screen app.
if [ -z "$cmd" ] && [ -t 1 ]; then
	cmd=tui
	set -- tui
fi

case "$cmd" in
tui)
	shift
	# The only compiled subcommand; install.sh builds it from lib/radin-tui.c.
	[ -x "$HOME/.claude/.radin/bin/radin-tui" ] || {
		printf 'radin tui: not built (no C compiler at install time). Use "radin backlog show".\n' >&2
		exit 1
	}
	RADIN_LIB="$LIB" exec "$HOME/.claude/.radin/bin/radin-tui" "$@"
	;;
backlog | state | scope | cbm-hooks | cbm-config | update | doctor | uninstall)
	shift
	exec bash "$LIB/radin-$cmd.sh" "$@"
	;;
help)
	usage
	;;
*)
	usage >&2
	exit 1
	;;
esac
